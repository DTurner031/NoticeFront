# Fuente de datos del frontend.
# mock: usa localStorage y datos simulados.
# api: preparación para consumir ASP.NET Core cuando el backend exista.
VITE_DATA_SOURCE=mock

# URL base futura del backend ASP.NET Core.
VITE_API_URL=http://localhost:5000/api

# Nombre de la llave donde se guardará el JWT cuando exista backend.
VITE_AUTH_TOKEN_KEY=noti_ice_auth_token
